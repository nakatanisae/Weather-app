---
import Layout from "../layouts/Layout.astro";
import "./css/style.css";
import { Icon } from "astro-icon/components";
---

<Layout>
  <main>
    <div id="mainSection">
      <div class="flexLocation">
        <select
          name="favoriteLocation"
          id="favoriteLocation"
          class="favLocation"
        >
          <option value="">Pick your favorite location</option>
          <option value="vancouver">Vancouver</option>
        </select>

        <div class="searchResultLocation">
          <button id="searchBtn" class="searchButton">
            <Icon name="carbon:location-current" size={15} />
            <span>Vancouver</span>
          </button>

          <div class="bgResultAPI">
            <div id="locationResult" class="flexSearch">
              <Icon name="ci:search-magnifying-glass" size={24} />
              <input
                id="searchLocation"
                type="text"
                placeholder="Search for a location"
                class="searchBox"
              />
            </div>

            <div id="apiResult" class="apiResultBox">978 granville street</div>
          </div>
        </div>
      </div>

      <div id="currentWeather">
        <h2 id="cityName">Vancouver</h2>
        <p id="cityDetail">
          Vancouver(city), British Columbia(administrative) - Canada(country)
        </p>
        <div class="flexTemperature">
          <h1 id="temperatureCelsius">18ºC</h1>
          <div class="flexCol">
            <Icon name="fontisto:day-cloudy" size={100} />
            <p>Mostly cloudy</p>
          </div>
        </div>

        <div id="weatherInfo">weather details</div>
      </div>
    </div>
  </main>
</Layout>
