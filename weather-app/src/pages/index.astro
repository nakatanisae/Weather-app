---
import Layout from "../layouts/Layout.astro";
import "../../css/style.css";
import { Icon } from "astro-icon/components";
---

<Layout>
  <main>
    <section>
      <!-- Menu -->
      <div class="flexLocation bgMenuLocation">
        <select
          name="favoriteLocation"
          id="favoriteLocation"
          class="favLocation"
        >
          <option value="" disabled selected>Favorite places</option>
        </select>
        <div class="searchResultLocation">
          <div id="selectLocation" class="bgResultAPI">
            <div id="locationResult" class="flexSearch">
              <Icon name="ci:search-magnifying-glass" size={24} />
              <input
                id="searchLocation"
                type="text"
                placeholder="Search Location"
                class="searchBox"
              />
            </div>
            <div id="apiResult" class="hidden apiResultBox"></div>
          </div>
        </div>
      </div>

      <!-- alert for missing favorite city -->
      <div id="customAlertBox" class="customAlert hidden">
        <div class="customAlertContent">
          <span id="closeAlert" class="close">&times;</span>
          <div class="flexRow">
            <Icon
              class="alertIcon"
              name="akar-icons:circle-alert-fill"
              size={70}
            />
            <p id="alertMessage"></p>
          </div>
        </div>
      </div>

      <!-- location and weather info -->
      <div class="gridWeather">
        <div class="flexMobile">
          <h2 id="cityTitle">
            <span id="cityName" class="city">Loading...</span>
            <span id="starOutlined" class="favoriteLocationIcon"
              ><Icon
                name="ant-design:star-outlined"
                size={24}
                class="star"
              /></span
            >
            <span id="starFilled" class="hidden favoriteLocationIcon"
              ><Icon
                name="ant-design:star-filled"
                size={24}
                class="star"
              /></span
            >
          </h2>

          <p id="cityDetail"></p>
          <p id="cityCoords" class="coords"></p>
          <h1><span id="temperatureCelsius"></span></h1>
        </div>

        <div class="flexCol">
          <h3 id="dayMessage" class="fontFamilySniglet messageDay"></h3>
          <div class="flexWeatherDetail">
            <div id="weatherIcon" class="iconWeather"></div>

            <div class="weatherDetail">
              <p>Feels like: <span id="apparentTemp"></span>ºC</p>
              <p>Rain: <span id="rain"></span>mm</p>
              <p>Wind speed: <span id="windSpeed"></span>km/h</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="dailyForecast">
      <h2>Forecast - 5 days</h2>

      <div class="dailyForecastCards">
        <button class="forecastCard" type="button" data-day-index="0">
          Day 1
        </button>

        <button class="forecastCard" type="button" data-day-index="1">
          Day 2
        </button>

        <button class="forecastCard" type="button" data-day-index="2">
          Day 3
        </button>

        <button class="forecastCard" type="button" data-day-index="3">
          Day 4
        </button>

        <button class="forecastCard" type="button" data-day-index="4">
          Day 5
        </button>
      </div>
    </section>

    <section class="hourlyRange">
      <h2>3 hour range</h2>
      <div id="hourly-container">
        <!-- <div class=hourlyCard></div> *The class is Added by script.js-->
      </div>
    </section>
  </main>
</Layout>
