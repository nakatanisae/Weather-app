---
import Layout from "../layouts/Layout.astro";
import "./css/style.css";
import { Icon } from "astro-icon/components";
---

<Layout>
  <main>
    <div id="mainSection">
      <div class="flexLocation bgMenuLocation">
        <select
          name="favoriteLocation"
          id="favoriteLocation"
          class="favLocation"
        >
          <option value="" disabled selected>Favorite locations</option>
        </select>

        <div class="searchResultLocation">
          <button id="searchBtn" class="searchButton">
            <Icon name="carbon:location-current" size={15} />
            <span id="actualLocation">Vancouver</span>
          </button>

          <div id="selectLocation" class="bgResultAPI hidden">
            <div id="locationResult" class="flexSearch">
              <Icon name="ci:search-magnifying-glass" size={24} />
              <input
                id="searchLocation"
                type="text"
                placeholder="Search for a location"
                class="searchBox"
              />
            </div>

            <div id="apiResult" class="hidden apiResultBox"></div>
          </div>
        </div>
      </div>

      <div class="flexMobile">
        <h2 id="cityTitle">
          <span id="cityName">Vancouver</span>
          <span id="starOutlined" class="favoriteLocationIcon"
            ><Icon name="ant-design:star-outlined" size={24} /></span
          >
          <span id="starFilled" class="hidden favoriteLocationIcon"
            ><Icon name="ant-design:star-filled" size={24} /></span
          >
        </h2>
        <p id="cityDetail">British Columbia - Canada.</p>
        <p id="cityCoords">Latitude: 49.2608724, Longitude: -123.1139529</p>
        <h1 id="temperatureCelsius">18ºC</h1>

        <!-- should update according to the weather -->
        <!-- <div class="windowContainer">
          <img
            src="/rain_background.png"
            alt="window showing dark sky"
            class="bgWindow"
          />
          <div class="rainOverlay"></div>
        </div> -->
      </div>
    </div>
  </main>
</Layout>
