---
import Layout from "../layouts/Layout.astro";
import "../../css/style.css";
import "../js/script.js";
---

<Layout>
  <main>
    <section class="dailyForecast">
      <h2>Daily Forecast - 5 days</h2>

      <div class="dailyForecastCards">
        <button class="forecastCard" type="button" data-day-index="0">
          Day 1
        </button>

        <button class="forecastCard" type="button" data-day-index="1">
          Day 2
        </button>

        <button class="forecastCard" type="button" data-day-index="2">
          Day 3
        </button>

        <button class="forecastCard" type="button" data-day-index="3">
          Day 4
        </button>

        <button class="forecastCard" type="button" data-day-index="4">
          Day 5
        </button>
      </div>
    </section>
  </main>
</Layout>